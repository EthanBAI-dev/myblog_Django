# 复制为 .env 并填入真实值，.env 不会被提交到 git

# 生产环境必须设置一个随机密钥，可用以下命令生成：
# python -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(50)))"
DJANGO_SECRET_KEY=change-me

# 生产环境务必设为 False
DJANGO_DEBUG=False

# 逗号分隔的域名列表，例如: example.com,www.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 邮箱 SMTP 密码/授权码（仅在 EMAIL_BACKEND 切换为真实 SMTP 后端时需要）
DJANGO_EMAIL_HOST_PASSWORD=
